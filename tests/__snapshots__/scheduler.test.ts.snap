exports[`Windows Task Scheduler > writes the VBScript launcher as UTF-16LE with a BOM 1`] = `
"' Generated by opencode-github-sync. Starts the autosync job with no window.
' Rewritten on every \`opencode-sync autosync install\`.
Dim shell, env, code
Set shell = CreateObject("WScript.Shell")
Set env = shell.Environment("PROCESS")
env("SYNC_HOME") = "C:\\Users\\鸽子 Lee"
code = shell.Run("""C:\\Program Files\\nodejs\\node.exe"" ""C:\\Users\\鸽子 Lee\\AppData\\Roaming\\npm\\node_modules\\opencode-github-sync\\dist\\cli\\index.js"" ""autosync"" ""run""", 0, True)
WScript.Quit code
"
`;

